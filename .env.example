# ==============================================================================
# CYBERSHIELD — MASTER CONFIGURATION BLUEPRINT (.env.example)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="CyberShield E-Commerce Defense Platform"
API_V1_PREFIX=/api/v1
SECURITY_V1_PREFIX=/security/v1

# Security & Encryption Secrets (Change in Production)
SECRET_KEY=cybershield-dev-secret-key-32-chars-minimum-length-needed-1234
JWT_SECRET=super-secret-jwt-signing-key-for-cybershield-tokens-9876
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Database (PostgreSQL)
POSTGRES_USER=cybershield_user
POSTGRES_PASSWORD=cybershield_pass
POSTGRES_DB=cybershield_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cybershield_user:cybershield_pass@localhost:5432/cybershield_db

# Dual-Mode SQLite Fallback (Used when PostgreSQL is unavailable locally)
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./cybershield_dev.db
USE_SQLITE_FALLBACK=true

# Fast State & Ingestion Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_KEY=events:runtime
REDIS_USE_FAKEREDIS_FALLBACK=true

# Graduated Risk Scoring Thresholds
RISK_THRESHOLD_MONITOR=30
RISK_THRESHOLD_THROTTLE=50
RISK_THRESHOLD_CONTAIN=85
CONFIDENCE_THRESHOLD_CONTAIN=0.85

# AI / LLM Security Reasoning Engine
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-1.5-pro

# Telemetry Configuration
OTEL_SERVICE_NAME=cybershield-ecommerce
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_ENABLED=false
